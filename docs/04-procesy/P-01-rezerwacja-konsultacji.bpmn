<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P01" targetNamespace="https://wspa.example/skw">
  <bpmn:collaboration id="Collaboration_P-01"><bpmn:participant id="Participant_P-01" name="Uczelnia" processRef="Process_P01"/></bpmn:collaboration>
  <bpmn:process id="Process_P01" name="P-01 Przeglądanie i zapis na konsultację" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P01">
      <bpmn:lane id="Lane_P01_Student" name="Student"><bpmn:flowNodeRef>Start_P01</bpmn:flowNodeRef><bpmn:flowNodeRef>Login_P01</bpmn:flowNodeRef><bpmn:flowNodeRef>Browse_P01</bpmn:flowNodeRef><bpmn:flowNodeRef>Filter_P01</bpmn:flowNodeRef><bpmn:flowNodeRef>Details_P01</bpmn:flowNodeRef><bpmn:flowNodeRef>Submit_P01</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_P01_System" name="System SKW"><bpmn:flowNodeRef>Access_P01</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Access_P01</bpmn:flowNodeRef><bpmn:flowNodeRef>Validate_P01</bpmn:flowNodeRef><bpmn:flowNodeRef>Available_P01</bpmn:flowNodeRef><bpmn:flowNodeRef>Duplicate_P01</bpmn:flowNodeRef><bpmn:flowNodeRef>Create_P01</bpmn:flowNodeRef><bpmn:flowNodeRef>Show_P01</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Unavailable_P01</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Duplicate_P01</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Success_P01</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_P01" name="Student szuka konsultacji"/>
    <bpmn:userTask id="Login_P01" name="Zaloguj się do SKW"/>
    <bpmn:exclusiveGateway id="Access_P01" name="Czy użytkownik ma rolę Student?"/>
    <bpmn:userTask id="Browse_P01" name="Przeglądaj przyszłe terminy"/>
    <bpmn:userTask id="Filter_P01" name="Filtruj listę terminów"/>
    <bpmn:userTask id="Details_P01" name="Otwórz szczegóły terminu"/>
    <bpmn:userTask id="Submit_P01" name="Zatwierdź zapis na termin"/>
    <bpmn:serviceTask id="Validate_P01" name="Sprawdź termin, limit i zapis"/>
    <bpmn:exclusiveGateway id="Available_P01" name="Czy termin jest dostępny?"/>
    <bpmn:exclusiveGateway id="Duplicate_P01" name="Czy istnieje już aktywny zapis?"/>
    <bpmn:serviceTask id="Create_P01" name="Utwórz aktywny zapis"/>
    <bpmn:serviceTask id="Show_P01" name="Wyświetl potwierdzenie i status"/>
    <bpmn:endEvent id="End_Access_P01" name="Odmowa dostępu"/>
    <bpmn:endEvent id="End_Unavailable_P01" name="Termin niedostępny"/>
    <bpmn:endEvent id="End_Duplicate_P01" name="Zapis już istnieje"/>
    <bpmn:endEvent id="End_Success_P01" name="Zapis potwierdzony"/>
    <bpmn:sequenceFlow id="F01_1" sourceRef="Start_P01" targetRef="Login_P01"/>
    <bpmn:sequenceFlow id="F01_2" sourceRef="Login_P01" targetRef="Access_P01"/>
    <bpmn:sequenceFlow id="F01_3" name="nie" sourceRef="Access_P01" targetRef="End_Access_P01"/>
    <bpmn:sequenceFlow id="F01_4" name="tak" sourceRef="Access_P01" targetRef="Browse_P01"/>
    <bpmn:sequenceFlow id="F01_5" sourceRef="Browse_P01" targetRef="Filter_P01"/>
    <bpmn:sequenceFlow id="F01_6" sourceRef="Filter_P01" targetRef="Details_P01"/>
    <bpmn:sequenceFlow id="F01_7" sourceRef="Details_P01" targetRef="Submit_P01"/>
    <bpmn:sequenceFlow id="F01_8" sourceRef="Submit_P01" targetRef="Validate_P01"/>
    <bpmn:sequenceFlow id="F01_9" sourceRef="Validate_P01" targetRef="Available_P01"/>
    <bpmn:sequenceFlow id="F01_10" name="nie — termin pełny, przeszły lub anulowany" sourceRef="Available_P01" targetRef="End_Unavailable_P01"/>
    <bpmn:sequenceFlow id="F01_11" name="tak" sourceRef="Available_P01" targetRef="Duplicate_P01"/>
    <bpmn:sequenceFlow id="F01_12" name="tak" sourceRef="Duplicate_P01" targetRef="End_Duplicate_P01"/>
    <bpmn:sequenceFlow id="F01_13" name="nie" sourceRef="Duplicate_P01" targetRef="Create_P01"/>
    <bpmn:sequenceFlow id="F01_14" sourceRef="Create_P01" targetRef="Show_P01"/>
    <bpmn:sequenceFlow id="F01_15" sourceRef="Show_P01" targetRef="End_Success_P01"/>
  </bpmn:process>
