    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Potrzebna konsultacja"/>
    <bpmn:manualTask id="T1" name="Poszukaj informacji o konsultacjach"/>
    <bpmn:manualTask id="T2" name="Skontaktuj się z wykładowcą"/>
