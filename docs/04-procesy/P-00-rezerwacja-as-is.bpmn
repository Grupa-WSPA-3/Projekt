    <bpmn:manualTask id="T7" name="Oceń zaproponowany termin"/>
    <bpmn:exclusiveGateway id="G1" name="Czy termin jest odpowiedni?"/>
    <bpmn:manualTask id="T4" name="Uzgodnij i potwierdź termin"/>
    <bpmn:manualTask id="T5" name="Prowadź listę zapisów"/>
    <bpmn:exclusiveGateway id="G2" name="Czy termin się zmienia?"/>
    <bpmn:manualTask id="T6" name="Poinformuj o zmianie lub rezygnacji"/>
    <bpmn:endEvent id="E1" name="Termin uzgodniony"/>
    <bpmn:endEvent id="E2" name="Termin zmieniony lub odwołany"/>
