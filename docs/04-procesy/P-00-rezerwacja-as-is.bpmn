<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P00" targetNamespace="https://wspa.example/skw">
  <bpmn:process id="Process_P00" name="P-00 Obecna organizacja konsultacji AS-IS" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P00">
      <bpmn:lane id="Lane_Student" name="Student"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>T1</bpmn:flowNodeRef><bpmn:flowNodeRef>T2</bpmn:flowNodeRef><bpmn:flowNodeRef>G1</bpmn:flowNodeRef><bpmn:flowNodeRef>T4</bpmn:flowNodeRef><bpmn:flowNodeRef>G2</bpmn:flowNodeRef><bpmn:flowNodeRef>T6</bpmn:flowNodeRef><bpmn:flowNodeRef>E1</bpmn:flowNodeRef><bpmn:flowNodeRef>E2</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Lecturer" name="Wykładowca"><bpmn:flowNodeRef>T3</bpmn:flowNodeRef><bpmn:flowNodeRef>T5</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Potrzebna konsultacja"/>
    <bpmn:task id="T1" name="Poszukaj informacji o konsultacjach"/>
    <bpmn:task id="T2" name="Skontaktuj się z wykładowcą"/>
    <bpmn:task id="T3" name="Przedstaw możliwy termin"/>
    <bpmn:exclusiveGateway id="G1" name="Czy termin jest odpowiedni?"/>
    <bpmn:task id="T4" name="Uzgodnij i potwierdź termin"/>
    <bpmn:task id="T5" name="Prowadź listę zapisów"/>
    <bpmn:exclusiveGateway id="G2" name="Czy termin się zmienia?"/>
    <bpmn:task id="T6" name="Poinformuj o zmianie lub rezygnacji"/>
    <bpmn:endEvent id="E1" name="Termin uzgodniony"/>
    <bpmn:endEvent id="E2" name="Termin zmieniony lub odwołany"/>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="T1"/>
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="T2"/>
    <bpmn:sequenceFlow id="F3" sourceRef="T2" targetRef="T3"/>
    <bpmn:sequenceFlow id="F4" sourceRef="T3" targetRef="G1"/>
    <bpmn:sequenceFlow id="F5" name="tak" sourceRef="G1" targetRef="T4"/>
    <bpmn:sequenceFlow id="F6" name="nie" sourceRef="G1" targetRef="E2"/>
    <bpmn:sequenceFlow id="F7" sourceRef="T4" targetRef="T5"/>
    <bpmn:sequenceFlow id="F8" sourceRef="T5" targetRef="G2"/>
    <bpmn:sequenceFlow id="F9" name="nie" sourceRef="G2" targetRef="E1"/>
    <bpmn:sequenceFlow id="F10" name="tak" sourceRef="G2" targetRef="T6"/>
    <bpmn:sequenceFlow id="F11" sourceRef="T6" targetRef="E2"/>
  </bpmn:process>
</bpmn:definitions>
